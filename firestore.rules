rules_version = '2';

// Reglas de Firestore del proyecto ailearn-ebf6e. Se publican a mano en la consola de Firebase
// (Firestore → Reglas): cada usuario solo lee y escribe su propio progreso.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/progress/{gameId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
